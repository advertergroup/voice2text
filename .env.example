# === Base de datos ===
DATABASE_URL="postgresql://voxtext:voxtext@localhost:5432/voxtext?schema=public"

# === App ===
APP_URL="http://localhost:3000"
AUTH_SECRET="cambia-esto-por-un-secreto-largo-aleatorio"
APP_PORT=3000

# === Cuenta admin (seed) ===
ADMIN_EMAIL="admin@voice2text.local"
ADMIN_PASSWORD="Voice2Text2026!"

# === Motor de transcripción (elige uno; se rellena luego) ===
# TRANSCRIBE_PROVIDER: mock (por defecto, texto de ejemplo) | openai | local
TRANSCRIBE_PROVIDER="mock"
# openai: transcripción vía API de OpenAI (Whisper)
OPENAI_API_KEY=""
OPENAI_TRANSCRIBE_MODEL="whisper-1"
# local: ejecuta un binario whisper/faster-whisper en el servidor
WHISPER_BIN=""
FFMPEG_BIN="ffmpeg"
# yt-dlp para descargar audio desde URLs (YouTube, etc.)
YTDLP_BIN=""

# === Stripe (suscripciones; se rellena luego) ===
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_TRIAL=""
STRIPE_PRICE_PREMIUM=""
