// Esquema de Voice2Text. Postgres (local embebido / prod Docker).
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}
enum SubStatus {
  NONE
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}
enum TransStatus {
  QUEUED
  PROCESSING
  DONE
  ERROR
}
enum TransMode {
  FAST
  STANDARD
  PRO
}
enum SourceType {
  FILE
  URL
  MIC
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  nombre               String?
  passwordHash         String?
  role                 Role      @default(USER)
  createdAt            DateTime  @default(now())

  // Suscripción
  subStatus            SubStatus @default(NONE)
  planKey              String?   // "trial" | "premium" ...
  stripeCustomerId     String?
  stripeSubscriptionId String?
  kunfupaySubscriptionId String? // id de suscripción en Kunfupay (de los webhooks)
  kunfupaySessionId    String?   // id de la sesión de checkout creada
  subEventAt           DateTime? // timestamp del último webhook aplicado (ignora eventos antiguos/fuera de orden)
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?

  transcripciones      Transcription[]
}

model Transcription {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  titulo      String      // nombre del fichero o de la URL
  sourceType  SourceType  @default(FILE)
  sourceUrl   String?
  language    String      @default("auto")
  mode        TransMode   @default(STANDARD)
  status      TransStatus @default(QUEUED)
  texto       String      @default("") @db.Text // texto (editable por el usuario)
  segmentos   Json?       // [{start,end,text}] para SRT/subtítulos
  duracionSeg Int?
  error       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId, createdAt])
}

// Textos editables del sitio (marca, copy, CTAs…). El panel de admin edita el `value`.
// Una fila por (clave, idioma) → toda la copy es multi-idioma.
model SiteContent {
  id        String  @id @default(cuid())
  key       String                    // p.ej. "hero.title"
  locale    String  @default("es")    // es | en | pt | fr | de | it | nl | pl
  value     String  @db.Text
  grupo     String  @default("General") // agrupación en el admin
  label     String                    // etiqueta legible para el admin
  multiline Boolean @default(false)
  orden     Int     @default(0)

  @@unique([key, locale])
  @@index([locale])
}

// Planes de precios (editables en admin). Una fila por (key, idioma); el precio es el mismo.
model Plan {
  id           String  @id @default(cuid())
  key          String
  locale       String  @default("es")
  nombre       String
  precioCent   Int     // céntimos
  moneda       String  @default("EUR")
  periodo      String  @default("month") // month | trial | year
  badge        String? // p.ej. "7 días" / "Más popular"
  descripcion  String? @db.Text
  caracteristicas Json // string[]
  botonTexto   String  @default("Empezar")
  stripePriceId String?
  kunfupayPlanId String? // paymentPlanId del plan recurrente en Kunfupay
  destacado    Boolean @default(false)
  orden        Int     @default(0)
  activo       Boolean @default(true)

  @@unique([key, locale])
  @@index([locale])
}

// Preguntas frecuentes (editables). Una fila por idioma.
model FaqItem {
  id       String @id @default(cuid())
  locale   String @default("es")
  pregunta String @db.Text
  respuesta String @db.Text
  orden    Int    @default(0)
  activo   Boolean @default(true)

  @@index([locale])
}

// Landings SEO (audio-a-texto, mp3-a-texto, youtube…), editables. Una fila por (slug, idioma).
model LandingPage {
  id        String @id @default(cuid())
  slug      String
  locale    String @default("es")
  titulo    String // <title> / H1
  subtitulo String @db.Text
  cuerpo    String @db.Text // HTML/markdown sencillo
  metaDesc  String @default("")
  orden     Int    @default(0)
  activo    Boolean @default(true)

  @@unique([slug, locale])
  @@index([locale])
}
