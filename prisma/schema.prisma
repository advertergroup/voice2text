// Esquema de Voice2Text. Postgres (local embebido / prod Docker).
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}
enum SubStatus {
  NONE
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}
enum TransStatus {
  QUEUED
  PROCESSING
  MANUAL     // pendiente de procesado manual (promesa <24h; el admin sube el archivo)
  DONE
  ERROR
}
enum TransMode {
  FAST
  STANDARD
  PRO
}
enum SourceType {
  FILE
  URL
  MIC
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  nombre               String?
  passwordHash         String?
  role                 Role      @default(USER)
  createdAt            DateTime  @default(now())

  // Suscripción
  subStatus            SubStatus @default(NONE)
  planKey              String?   // "trial" | "premium" ...
  stripeCustomerId     String?
  stripeSubscriptionId String?
  kunfupaySubscriptionId String? // id de suscripción en Kunfupay (de los webhooks)
  kunfupaySessionId    String?   // id de la sesión de checkout creada
  subEventAt           DateTime? // timestamp del último webhook aplicado (ignora eventos antiguos/fuera de orden)
  cancelAtPeriodEnd    Boolean   @default(false) // el usuario canceló; acceso hasta el fin del periodo
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?

  transcripciones      Transcription[]
}

model Transcription {
  id          String      @id @default(cuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  anonSession String?     // subida anónima (cookie) hasta que se registre/reclame
  titulo      String      // nombre del fichero o de la URL
  sourceType  SourceType  @default(FILE)
  sourceUrl   String?
  origen      String?     // "ads" si la subida vino de tráfico de Google Ads (cookie v2t_src)
  language    String      @default("auto")
  mode        TransMode   @default(STANDARD)
  status      TransStatus @default(QUEUED)
  locked      Boolean     @default(true)          // true = solo preview hasta pagar
  preview     String      @default("") @db.Text   // texto del inicio (teaser real)
  previewSeg  Int         @default(60)            // segundos cubiertos por la preview
  texto       String      @default("") @db.Text   // texto COMPLETO (vacío hasta desbloquear)
  segmentos   Json?       // [{start,end,text}] para SRT/subtítulos (completo)
  duracionSeg Int?
  fileKey     String?     // archivo guardado (para transcribir el resto al pagar)
  fileExpiresAt DateTime? // cuándo se borra el archivo si no paga
  fileDeleted Boolean     @default(false)
  partial     Boolean     @default(false) // solo se subió el inicio (archivo grande) → resubir completo tras pagar
  recoveryStage Int       @default(0)             // emails de recuperación enviados (fase 2)
  contactEmail String?    // email para avisar cuando la transcripción manual esté lista
  error       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([anonSession])
  @@index([locked, fileExpiresAt])
}

// Textos editables del sitio (marca, copy, CTAs…). El panel de admin edita el `value`.
// Una fila por (clave, idioma) → toda la copy es multi-idioma.
model SiteContent {
  id        String  @id @default(cuid())
  key       String                    // p.ej. "hero.title"
  locale    String  @default("es")    // es | en | pt | fr | de | it | nl | pl
  value     String  @db.Text
  grupo     String  @default("General") // agrupación en el admin
  label     String                    // etiqueta legible para el admin
  multiline Boolean @default(false)
  orden     Int     @default(0)

  @@unique([key, locale])
  @@index([locale])
}

// Planes de precios (editables en admin). Una fila por (key, idioma); el precio es el mismo.
model Plan {
  id           String  @id @default(cuid())
  key          String
  locale       String  @default("es")
  nombre       String
  precioCent   Int     // céntimos
  moneda       String  @default("EUR")
  periodo      String  @default("month") // month | trial | year
  badge        String? // p.ej. "7 días" / "Más popular"
  descripcion  String? @db.Text
  caracteristicas Json // string[]
  botonTexto   String  @default("Empezar")
  stripePriceId String?
  kunfupayPlanId String? // paymentPlanId del plan recurrente en Kunfupay
  destacado    Boolean @default(false)
  orden        Int     @default(0)
  activo       Boolean @default(true)

  @@unique([key, locale])
  @@index([locale])
}

// Preguntas frecuentes (editables). Una fila por idioma.
model FaqItem {
  id       String @id @default(cuid())
  locale   String @default("es")
  pregunta String @db.Text
  respuesta String @db.Text
  orden    Int    @default(0)
  activo   Boolean @default(true)

  @@index([locale])
}

// Landings SEO (audio-a-texto, mp3-a-texto, youtube…), editables. Una fila por (slug, idioma).
model LandingPage {
  id        String @id @default(cuid())
  slug      String
  locale    String @default("es")
  titulo    String // <title> / H1
  subtitulo String @db.Text
  cuerpo    String @db.Text // HTML/markdown sencillo
  metaDesc  String @default("")
  orden     Int    @default(0)
  activo    Boolean @default(true)

  @@unique([slug, locale])
  @@index([locale])
}

/// Rastro del agente de soporte automático (support@): qué se hizo con cada email.
model SupportLog {
  id        String   @id @default(cuid())
  email     String
  subject   String?
  accion    String
  detalle   String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

/// Evento de analítica (pageviews del middleware + funnel del servidor + beacons del checkout).
model Evento {
  id        String   @id @default(cuid())
  tipo      String   // pageview | offer_shown | offer_accepted | purchase | upgrade
  vid       String?  // visitante (cookie v2t_vid)
  userId    String?
  trId      String?
  path      String?
  locale    String?
  origen    String?  // "ads" (Google Ads) | null (orgánico/directo)
  referer   String?
  valorCent Int?     // importe en céntimos para purchase/upgrade
  meta      String?  // p. ej. id del PaymentIntent (idempotencia de purchase)
  createdAt DateTime @default(now())

  @@index([tipo, createdAt])
  @@index([vid, createdAt])
}
